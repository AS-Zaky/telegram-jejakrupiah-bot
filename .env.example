# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Google AI Studio API key (Gemini)
GEMINI_API_KEY=

# Optional. Model Gemini yang dipakai untuk ekstraksi teks & foto.
GEMINI_MODEL=gemini-3.8-flash

# Optional. Model cadangan kalau model utama kena 503 UNAVAILABLE.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash-lite

# PostgreSQL connection string
# Supabase: pakai connection string Pooler (host pooler.supabase.com).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jejakrupiah

# Optional. Comma separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone.
ALLOWED_TELEGRAM_IDS=

# Optional. Timezone used to compute "today" and monthly reports.
APP_TIMEZONE=Asia/Jakarta
